# Production values for compose.prod.yaml on the AWS VM. Copy to .env ON THE VM ONLY, fill in every
# empty value, and never commit the result. Generate APP_KEY once with:
#   docker compose -f compose.prod.yaml run --rm app php artisan key:generate --show

APP_NAME="SETI Activos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_DOMAIN=
APP_URL=https://${APP_DOMAIN}
APP_TIMEZONE=America/Costa_Rica

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Containers log to stderr; read them with `docker compose -f compose.prod.yaml logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=seti
DB_USERNAME=seti
# A long random password: openssl rand -base64 32
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
# Minutes after sign-in at which a session ends even while in use (SESSION_LIFETIME only ends idle ones).
SESSION_ABSOLUTE_LIFETIME=540
SESSION_ENCRYPT=true
# Superusuario and Administradores must set up two-factor authentication before using the application. Keep it true.
TWO_FACTOR_REQUIRED=true
SESSION_SECURE_COOKIE=true
# The __Host- prefix makes browsers refuse this cookie unless it is Secure, host-only and for path /, so another site
# under the same parent domain (*.tec.ac.cr) cannot plant a session cookie for this one. Keep SESSION_DOMAIN=null.
SESSION_COOKIE=__Host-seti-session
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
FILES_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# The institution's SMTP relay (invitations and password resets).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8000
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${APP_DOMAIN}"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Current delivery sprint: later planned reports appear as Próximamente.
REPORTS_CURRENT_SPRINT=1

# Power BI secure-embed URL (File > Embed report > Website or portal). Empty: the page says it is not configured.
POWERBI_EMBED_URL=
