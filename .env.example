# Local development defaults for the Docker stack (compose.yaml).
# Copy to .env (`cp .env.example .env`) and run `php artisan key:generate` inside the app container.
# Never commit .env. Production values live in .env.production.example.

APP_NAME="SETI Activos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Costa_Rica

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18 (the `pgsql` service). Tests use the `seti_testing` database (phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=seti
DB_USERNAME=seti
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
# Minutes after sign-in at which a session ends even while in use (SESSION_LIFETIME only ends idle ones).
SESSION_ABSOLUTE_LIFETIME=540
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Every email (invitations, password resets) is caught by Mailpit: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@seti.test"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb (WebSockets). Server side: the app reaches the `reverb` container directly.
REVERB_APP_ID=seti-local
REVERB_APP_KEY=seti-local-key
REVERB_APP_SECRET=seti-local-secret
REVERB_HOST=reverb
REVERB_PORT=8000
REVERB_SCHEME=http

# Browser side: your browser reaches Reverb through the port published on your machine.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Ports published on your machine (change them if something else already uses one).
APP_PORT=8000
VITE_PORT=5173
REVERB_FORWARD_PORT=8080
FORWARD_DB_PORT=5433
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# Linux/WSL2 only: your user and group ids (`id -u`, `id -g`), so files created in the containers stay yours.
UID=1000
GID=1000

# Current delivery sprint: later planned reports appear as Próximamente.
REPORTS_CURRENT_SPRINT=1
