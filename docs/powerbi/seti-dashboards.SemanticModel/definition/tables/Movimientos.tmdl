table Movimientos
	lineageTag: aececadb-8693-5400-84f4-67ddb8997038

	measure 'Total movimientos' = COUNTROWS(Movimientos) + 0
		formatString: #,0
		lineageTag: 29012e76-b481-52fb-9a90-adb19c8251fa

	measure Traslados = CALCULATE(COUNTROWS(Movimientos), Movimientos[type] = "transfer") + 0
		formatString: #,0
		lineageTag: 563a8634-94d1-55eb-a3af-87a7be97a57f

	measure Ingresos = CALCULATE(COUNTROWS(Movimientos), Movimientos[type] = "entry") + 0
		formatString: #,0
		lineageTag: eb3c6cd7-81ab-50c7-9e25-bee97ff75876

	column id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: id
