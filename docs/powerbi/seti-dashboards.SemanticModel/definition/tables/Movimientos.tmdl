	column Tipo = SWITCH([type], "entry", "Ingreso", "transfer", "Traslado", "exit", "Salida", [type])
		dataType: string
		summarizeBy: none
		lineageTag: d1192f11-e52a-5021-af6d-667c6a7c5e30

		annotation SummarizationSetBy = Automatic

	column Fecha = DATE(YEAR([moved_at]), MONTH([moved_at]), DAY([moved_at]))
		dataType: dateTime
