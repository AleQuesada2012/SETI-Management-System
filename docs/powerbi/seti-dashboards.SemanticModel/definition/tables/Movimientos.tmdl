		annotation SummarizationSetBy = Automatic

	partition Movimientos = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(FeedUrl, [RelativePath = "asset_movements.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"id", Int64.Type}, {"asset_id", Int64.Type}, {"asset_code", type text}, {"asset_name", type text}, {"type", type text}, {"from_space_id", Int64.Type}, {"from_space_name", type text}, {"to_space_id", Int64.Type}, {"to_space_name", type text}, {"moved_at", type datetime}, {"moved_by_name", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
