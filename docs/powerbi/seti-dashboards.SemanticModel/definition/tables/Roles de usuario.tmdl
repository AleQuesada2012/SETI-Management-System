table 'Roles de usuario'
	lineageTag: 9588e3a2-4f75-5943-8c8c-89bb75e0f7d5

	measure 'Usuarios con rol' = COUNTROWS('Roles de usuario') + 0
		formatString: #,0
		lineageTag: a6002da9-77af-5603-89e4-dd02d6882ea1

	column user_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: user_id
		lineageTag: 6ec1aab9-38be-56e3-941b-c785d5ddad24

		annotation SummarizationSetBy = Automatic

	column role_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: role_id
		lineageTag: 1ca0341d-6eaf-581c-8ef4-9f6d794fda44

		annotation SummarizationSetBy = Automatic

	column role
		dataType: string
		summarizeBy: none
		sourceColumn: role
		lineageTag: de6819de-8e4b-5e98-8f46-9aefd6049d16

		annotation SummarizationSetBy = Automatic

	partition 'Roles de usuario' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(FeedUrl, [RelativePath = "user_roles.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"user_id", Int64.Type}, {"role_id", Int64.Type}, {"role", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
