		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source = ```
				VAR firstDay = MINX({ MIN(Reservas[local_date]), MIN(Mantenimientos[reference_date]), MIN(Movimientos[Fecha]), MIN('Eventos de activos'[occurred_on]), MIN('Reportes generados'[Fecha]) }, [Value])
				VAR lastDay = MAXX({ MAX(Reservas[local_date]), TODAY() + 30 }, [Value])
				RETURN
				  ADDCOLUMNS(
				    CALENDAR(COALESCE(firstDay, TODAY() - 365), lastDay),
				    "Año", YEAR([Date]),
				    "Mes", SWITCH(MONTH([Date]), 1, "ene", 2, "feb", 3, "mar", 4, "abr", 5, "may", 6, "jun", 7, "jul", 8, "ago", 9, "sep", 10, "oct", 11, "nov", "dic") & " " & YEAR([Date]),
				    "Mes (orden)", YEAR([Date]) * 100 + MONTH([Date]),
				    "Semana", [Date] - WEEKDAY([Date], 2) + 1,
				    "Día de la semana", SWITCH(WEEKDAY([Date], 2), 1, "Lunes", 2, "Martes", 3, "Miércoles", 4, "Jueves", 5, "Viernes", 6, "Sábado", "Domingo"),
				    "Día (orden)", WEEKDAY([Date], 2),
				    "Día hábil", WEEKDAY([Date], 2) <= 6
				  )
				```

	annotation PBI_Id = calendario
