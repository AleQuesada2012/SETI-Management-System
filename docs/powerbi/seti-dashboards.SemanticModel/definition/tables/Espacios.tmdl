	partition Espacios = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(FeedUrl, [RelativePath = "spaces.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"id", Int64.Type}, {"code", type text}, {"name", type text}, {"space_type", type text}, {"status", type text}, {"status_color", type text}, {"is_reservable", type logical}, {"is_occupied", type logical}, {"building", type text}, {"floor", type text}, {"capacity", Int64.Type}, {"managers", type text}, {"asset_count", Int64.Type}, {"created_at", type datetime}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
