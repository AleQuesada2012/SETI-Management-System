table Espacios
	lineageTag: 73ddf0e5-32e4-59de-b6eb-ddcf3ade5cac

	measure 'Total espacios' = COUNTROWS(Espacios) + 0
		formatString: #,0
		lineageTag: 8540b286-d838-56ca-a0f2-3b0d5f40c79f

	measure 'Espacios reservables' = CALCULATE(COUNTROWS(Espacios), Espacios[is_reservable] = TRUE()) + 0
		formatString: #,0
		lineageTag: 6f6d571a-9ffe-524e-a989-8dd303d5267d

	measure 'Espacios ocupados' = CALCULATE(COUNTROWS(Espacios), Espacios[is_occupied] = TRUE()) + 0
		formatString: #,0
		lineageTag: f76fec5d-4739-5ffe-961b-9b02da428c54

	measure 'Capacidad total' = SUM(Espacios[capacity]) + 0
		formatString: #,0
		lineageTag: 2be03dc1-1f91-56d2-8b15-8f9cf92dfaac

