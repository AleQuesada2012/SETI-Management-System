	partition 'Reportes generados' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(FeedUrl, [RelativePath = "report_generations.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"id", Int64.Type}, {"report_code", type text}, {"report_name", type text}, {"report_category", type text}, {"format", type text}, {"row_count", Int64.Type}, {"generated_by", Int64.Type}, {"generated_by_name", type text}, {"generated_at", type datetime}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
