table Mantenimientos
	lineageTag: 2f030616-968c-51ba-a1a8-f8db1de8328f

	measure 'Total mantenimientos' = COUNTROWS(Mantenimientos) + 0
		formatString: #,0
		lineageTag: 1963a5df-b683-598e-8cff-8004871251ed

	measure Preventivos = CALCULATE(COUNTROWS(Mantenimientos), Mantenimientos[kind] = "preventive") + 0
		formatString: #,0
		lineageTag: b22bb85e-fb07-5fbc-a7c6-c9e5572384fb

	measure Correctivos = CALCULATE(COUNTROWS(Mantenimientos), Mantenimientos[kind] = "corrective") + 0
		formatString: #,0
		lineageTag: 124d2f32-5121-59a0-a83e-de1f42965009

	measure '% preventivo' = DIVIDE([Preventivos], [Total mantenimientos])
		formatString: 0.0%
		lineageTag: d735ec4a-53b3-5eeb-8fa7-6617bb598aa8

	measure Pendientes = CALCULATE(COUNTROWS(Mantenimientos), Mantenimientos[status] IN {"scheduled", "in_progress"}) + 0
		formatString: #,0
		lineageTag: 3d20c99e-e36e-54bd-987e-d7fecf03591e

	measure Vencidos = CALCULATE(COUNTROWS(Mantenimientos), Mantenimientos[Vencido] = "Vencido") + 0
		formatString: #,0
		lineageTag: 171a8558-cd86-5c58-bc89-3aed049e9020

	measure 'Promedio de días de atención' = AVERAGE(Mantenimientos[Días de atención])
		formatString: #,0.0
		lineageTag: 285dfcbc-e143-5a20-8869-c36003eb42fb

