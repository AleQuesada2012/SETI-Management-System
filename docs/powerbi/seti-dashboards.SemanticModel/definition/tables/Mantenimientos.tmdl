	column Tipo = SWITCH([kind], "preventive", "Preventivo", "corrective", "Correctivo", [kind])
		dataType: string
		summarizeBy: none
		lineageTag: 986c634c-97b7-5f1c-94bf-94354502df44

		annotation SummarizationSetBy = Automatic

	column Estado = SWITCH([status], "scheduled", "Programado", "in_progress", "En curso", "completed", "Completado", "cancelled", "Cancelado", [status])
		dataType: string
		summarizeBy: none
		lineageTag: 2bc3170c-326f-5ee0-952d-39bfa303215a

		annotation SummarizationSetBy = Automatic

	column 'Días de atención' = IF(NOT ISBLANK([started_on]) && NOT ISBLANK([completed_on]), INT([completed_on] - [started_on]))
		dataType: int64
		formatString: 0
		summarizeBy: none
		lineageTag: fb00e5bb-443a-5818-b44d-13c891711510

		annotation SummarizationSetBy = Automatic

	column Vencido = IF([status] = "scheduled" && [scheduled_for] < TODAY(), "Vencido", "Al día")
		dataType: string
		summarizeBy: none
		lineageTag: 42a3e369-bdc8-5731-abd7-3ec576e1d892

		annotation SummarizationSetBy = Automatic

	partition Mantenimientos = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(FeedUrl, [RelativePath = "maintenance.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"id", Int64.Type}, {"asset_id", Int64.Type}, {"asset_code", type text}, {"asset_name", type text}, {"kind", type text}, {"status", type text}, {"scheduled_for", type date}, {"started_on", type date}, {"completed_on", type date}, {"reference_date", type date}, {"performed_by", type text}, {"registered_by_name", type text}, {"created_at", type datetime}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
