table Activos
	lineageTag: e368b9d3-d641-4de2-a748-3cef83495338

	measure 'Total activos' = COUNTROWS(Activos)
		formatString: #,0
		lineageTag: a3064e9c-193d-4586-a6c5-022b4f9bee75

	measure 'Activos en servicio' = CALCULATE(COUNTROWS(Activos), Activos[status] = "in_service") + 0
		formatString: #,0
		lineageTag: 8c1f01f0-0f95-4e83-a329-dae6b52d5e00

	measure 'Activos en mantenimiento' = CALCULATE(COUNTROWS(Activos), Activos[status] = "in_maintenance") + 0
		formatString: #,0
		lineageTag: 466ccae5-dbe0-4339-adde-afa0571cbccd

	measure 'Activos dañados' = CALCULATE(COUNTROWS(Activos), Activos[condition] = "Dañado") + 0
		formatString: #,0
		lineageTag: b3e9ad7f-89e9-4ff4-a631-f095ada3c686

