table Activos
	lineageTag: 8cd71799-d930-5583-a860-d2149bffe380

	measure 'Total activos' = COUNTROWS(Activos) + 0
		formatString: #,0
		lineageTag: 4b6c4465-d46f-5722-939a-12ba66700d3a

	measure 'Activos en servicio' = CALCULATE(COUNTROWS(Activos), Activos[status] = "in_service") + 0
		formatString: #,0
		lineageTag: bd504597-7fc5-51c4-9bdf-adccee2afbf6

	measure 'Activos en mantenimiento' = CALCULATE(COUNTROWS(Activos), Activos[status] = "in_maintenance") + 0
		formatString: #,0
		lineageTag: 4be91f99-4e1c-5aa0-8973-a2f12ed33847

	measure 'Activos dañados' = CALCULATE(COUNTROWS(Activos), Activos[condition] = "Dañado") + 0
		formatString: #,0
		lineageTag: 1a0de8a6-7698-5ba7-b9af-8c3b9890bcc8

	measure '% en servicio' = DIVIDE([Activos en servicio], CALCULATE(COUNTROWS(Activos), Activos[status] <> "decommissioned"))
		formatString: 0.0%
		lineageTag: dfa9173a-00ef-5760-bfbb-9f32099a9494

	measure 'Garantías por vencer (90 días)' = CALCULATE(COUNTROWS(Activos), Activos[Días para vencer la garantía] <= 90) + 0
		formatString: #,0
		lineageTag: f7c2d557-255f-5c2d-8c74-59d8de92a4be

	measure 'Garantías vencidas' = CALCULATE(COUNTROWS(Activos), Activos[warranty_state] = "expired") + 0
		formatString: #,0
		lineageTag: 0b627259-70f1-5498-9f83-cc59d332399f

	measure 'Activos sin responsable' = CALCULATE(COUNTROWS(Activos), ISBLANK(Activos[responsible_user_id]), Activos[status] <> "decommissioned") + 0
		formatString: #,0
		lineageTag: 36acf790-6b0f-5fc4-94c1-be36ef708fa3

