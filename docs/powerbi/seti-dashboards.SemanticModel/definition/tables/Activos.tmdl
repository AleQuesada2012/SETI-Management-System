	column Estado = SWITCH([status], "in_service", "En servicio", "in_maintenance", "En mantenimiento", "lost", "Perdido", "decommissioned", "De baja", [status])
		dataType: string
		summarizeBy: none
		lineageTag: a12a9eab-7e74-5edb-a66a-2c6e86b879e6

		annotation SummarizationSetBy = Automatic

	column 'Garantía' = SWITCH([warranty_state], "valid", "Vigente", "expired", "Vencida", "Sin garantía")
		dataType: string
		summarizeBy: none
		lineageTag: 6beee86c-6895-5f0c-a7b8-3feafa172b96

		annotation SummarizationSetBy = Automatic

	column 'Días para vencer la garantía' = IF(NOT ISBLANK([warranty_ends_on]) && [warranty_ends_on] >= TODAY(), INT([warranty_ends_on] - TODAY()))
		dataType: int64
		formatString: 0
		summarizeBy: none
		lineageTag: 3af6a75d-7663-5566-91e5-a788bb7a2200

		annotation SummarizationSetBy = Automatic

	column 'Antigüedad' = VAR years = DATEDIFF([acquired_on], TODAY(), DAY) / 365.25 RETURN SWITCH(TRUE(), ISBLANK([acquired_on]), "Sin fecha", years < 1, "Menos de 1 año", years < 3, "De 1 a 3 años", years < 5, "De 3 a 5 años", "Más de 5 años")
		dataType: string
		summarizeBy: none
		sortByColumn: 'Antigüedad (orden)'
		lineageTag: 050f57bc-60c8-59ed-98ad-1effc730b6c5

		annotation SummarizationSetBy = Automatic

	column 'Antigüedad (orden)' = VAR years = DATEDIFF([acquired_on], TODAY(), DAY) / 365.25 RETURN SWITCH(TRUE(), ISBLANK([acquired_on]), 5, years < 1, 1, years < 3, 2, years < 5, 3, 4)
		dataType: int64
		formatString: 0
		summarizeBy: none
		lineageTag: 0dc5e274-7391-55fa-8a7b-291ceec24861

		annotation SummarizationSetBy = Automatic

	column Responsable = COALESCE([responsible_name], "Sin responsable")
		dataType: string
		summarizeBy: none
		lineageTag: f9784df4-1faa-520c-9626-f27cba160757

		annotation SummarizationSetBy = Automatic

	partition Activos = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(FeedUrl, [RelativePath = "assets.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"id", Int64.Type}, {"code", type text}, {"asset_tag", type text}, {"display_name", type text}, {"name", type text}, {"category", type text}, {"asset_type", type text}, {"brand", type text}, {"model", type text}, {"condition", type text}, {"condition_color", type text}, {"status", type text}, {"space_id", Int64.Type}, {"space_code", type text}, {"space_name", type text}, {"building", type text}, {"responsible_user_id", Int64.Type}, {"responsible_name", type text}, {"supplier", type text}, {"acquired_on", type date}, {"warranty_starts_on", type date}, {"warranty_ends_on", type date}, {"warranty_state", type text}, {"created_at", type datetime}, {"updated_at", type datetime}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
