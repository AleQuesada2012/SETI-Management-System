table Usuarios
	lineageTag: 5664e8b6-1c18-4240-b589-2b97f7390bbb

	measure 'Total usuarios' = COUNTROWS(Usuarios)
		formatString: #,0
		lineageTag: ba94a923-b4de-44d9-adfc-d331f0a3679a

	measure 'Usuarios activos' = CALCULATE(COUNTROWS(Usuarios), Usuarios[account_status] = "active") + 0
		formatString: #,0
		lineageTag: b03d4134-f528-4871-a79b-90ecc1ca17e5

	measure 'Usuarios desactivados' = CALCULATE(COUNTROWS(Usuarios), Usuarios[account_status] = "deactivated") + 0
		formatString: #,0
		lineageTag: 16b3f3c8-1422-4f8d-a6bc-3e50c642c88e

	measure 'Invitaciones pendientes' = CALCULATE(COUNTROWS(Usuarios), Usuarios[invitation_pending] = TRUE()) + 0
		formatString: #,0
		lineageTag: 29c45220-96b3-43a2-a2e9-1dda27ec22d3

