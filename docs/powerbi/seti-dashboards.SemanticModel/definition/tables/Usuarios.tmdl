table Usuarios
	lineageTag: dff4d9f2-8165-5305-a679-a972f38f0edb

	measure 'Total usuarios' = COUNTROWS(Usuarios) + 0
		formatString: #,0
		lineageTag: 7b9d9c5a-40a2-5baf-8789-5f70d7176347

	measure 'Usuarios activos' = CALCULATE(COUNTROWS(Usuarios), Usuarios[account_status] = "active") + 0
		formatString: #,0
		lineageTag: 8669e10c-9426-569f-81ca-aaf61d53d9b0

	measure 'Usuarios desactivados' = CALCULATE(COUNTROWS(Usuarios), Usuarios[account_status] = "deactivated") + 0
		formatString: #,0
		lineageTag: 85c88f51-3ae7-5292-b317-1419f41c2cf2

	measure 'Invitaciones pendientes' = CALCULATE(COUNTROWS(Usuarios), Usuarios[invitation_pending] = TRUE()) + 0
		formatString: #,0
		lineageTag: 49d77b25-f018-554e-a530-7cca63c031c3

	measure 'Con acceso en 30 días' = CALCULATE(COUNTROWS(Usuarios), Usuarios[account_status] = "active", Usuarios[last_login_at] >= NOW() - 30) + 0
		formatString: #,0
		lineageTag: c9b7da57-a67e-560e-b585-c4e17d082e65

	measure '% de adopción' = DIVIDE([Con acceso en 30 días], [Usuarios activos])
		formatString: 0.0%
		lineageTag: 9d0f34d8-d11f-5e9e-bdac-8e37456c5aa6

	column id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: id
		lineageTag: e61824dd-2ca4-5249-896f-803bbd98d31e

		annotation SummarizationSetBy = Automatic

	column name
		dataType: string
		summarizeBy: none
		sourceColumn: name
		lineageTag: 49e8c4cd-9e7c-5c06-b302-744f7f92cb3f

		annotation SummarizationSetBy = Automatic

	column account_status
		dataType: string
		summarizeBy: none
		sourceColumn: account_status
		lineageTag: 2aef0445-9d5f-5ba6-a85c-bccc608f2337

		annotation SummarizationSetBy = Automatic

	column invitation_pending
		dataType: boolean
		summarizeBy: none
		sourceColumn: invitation_pending
		lineageTag: bdbbbf8a-c6a0-5ef0-a06f-7cbb71b70cea

		annotation SummarizationSetBy = Automatic

	column roles
		dataType: string
		summarizeBy: none
		sourceColumn: roles
		lineageTag: 7df6ef2b-e680-57e9-a1b0-af9dd70341b2

		annotation SummarizationSetBy = Automatic

	column last_login_at
		dataType: dateTime
		formatString: dd/mm/yyyy hh:mm
		summarizeBy: none
		sourceColumn: last_login_at
		lineageTag: 5b347930-bb5b-584e-9b21-bd534341d503

		annotation SummarizationSetBy = Automatic

	column deactivated_at
		dataType: dateTime
		formatString: dd/mm/yyyy hh:mm
		summarizeBy: none
		sourceColumn: deactivated_at
		lineageTag: 84599fa9-c224-5cd1-949b-e873160deff9

		annotation SummarizationSetBy = Automatic

	column created_at
		dataType: dateTime
		formatString: dd/mm/yyyy hh:mm
		summarizeBy: none
		sourceColumn: created_at
		lineageTag: b5fbf258-0f0a-55d9-a074-6f8e1e75422d

		annotation SummarizationSetBy = Automatic

	column 'Estado de cuenta' = SWITCH([account_status], "active", "Activa", "deactivated", "Desactivada", [account_status])
		dataType: string
		summarizeBy: none
		lineageTag: 2a37ba43-3cb5-5a1e-8228-cc708dc76a26

		annotation SummarizationSetBy = Automatic

	column 'Último acceso' = VAR days = INT(NOW() - [last_login_at]) RETURN SWITCH(TRUE(), ISBLANK([last_login_at]), "Nunca", days <= 7, "Últimos 7 días", days <= 30, "De 8 a 30 días", days <= 90, "De 31 a 90 días", "Más de 90 días")
		dataType: string
		summarizeBy: none
		sortByColumn: 'Último acceso (orden)'
		lineageTag: 6978e0cf-b3bb-5f61-83e1-3ab636e5ddf9

		annotation SummarizationSetBy = Automatic

	column 'Último acceso (orden)' = VAR days = INT(NOW() - [last_login_at]) RETURN SWITCH(TRUE(), ISBLANK([last_login_at]), 5, days <= 7, 1, days <= 30, 2, days <= 90, 3, 4)
		dataType: int64
		formatString: 0
		summarizeBy: none
		lineageTag: e00b4af6-fc8d-5a35-bd83-ca7e355f39af

		annotation SummarizationSetBy = Automatic

	partition Usuarios = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(FeedUrl, [RelativePath = "users.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"id", Int64.Type}, {"name", type text}, {"account_status", type text}, {"invitation_pending", type logical}, {"roles", type text}, {"last_login_at", type datetime}, {"deactivated_at", type datetime}, {"created_at", type datetime}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
