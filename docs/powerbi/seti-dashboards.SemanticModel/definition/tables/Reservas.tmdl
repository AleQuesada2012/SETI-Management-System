	column Estado = SWITCH([effective_status], "upcoming", "Próxima", "in_progress", "En curso", "finished", "Finalizada", "cancelled", "Cancelada", [effective_status])
		dataType: string
		summarizeBy: none
		lineageTag: e2537619-c057-57c2-991a-1bdce65f146a

		annotation SummarizationSetBy = Automatic

	column 'Hora de inicio' = HOUR([starts_at])
		dataType: int64
		formatString: 0
		summarizeBy: none
		lineageTag: 640bd069-51e9-5ebc-b52f-eb108aa8b9c0

		annotation SummarizationSetBy = Automatic

	column 'Duración (horas)' = DATEDIFF([starts_at], [ends_at], MINUTE) / 60
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		lineageTag: 7ebbf72c-7917-5334-b9cf-ea73f9d28528

		annotation SummarizationSetBy = Automatic

	column 'Días de anticipación' = IF([created_at] <= [starts_at], INT([starts_at] - [created_at]), 0)
		dataType: int64
		formatString: 0
		summarizeBy: none
		lineageTag: 77e012b3-4b9e-5642-9a4d-d7cf3ce95230

		annotation SummarizationSetBy = Automatic

	column Frecuencia = IF(ISBLANK([series_id]), "Única", "Recurrente")
		dataType: string
		summarizeBy: none
		lineageTag: e2cb3db3-6e36-5ec5-89c7-efeaa3faa51e

		annotation SummarizationSetBy = Automatic

	column Responsable = COALESCE([responsible_name], "Sin responsable")
		dataType: string
		summarizeBy: none
		lineageTag: 2417ad20-c383-57a8-b34f-dd49f3aafe15

		annotation SummarizationSetBy = Automatic

	partition Reservas = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(FeedUrl, [RelativePath = "reservations.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"id", Int64.Type}, {"series_id", type text}, {"space_id", Int64.Type}, {"space_code", type text}, {"space_name", type text}, {"space_deleted", type logical}, {"starts_at", type datetime}, {"ends_at", type datetime}, {"local_date", type date}, {"attendees", Int64.Type}, {"responsible_id", Int64.Type}, {"responsible_name", type text}, {"created_by_name", type text}, {"status", type text}, {"effective_status", type text}, {"was_modified", type logical}, {"cancelled_at", type datetime}, {"created_at", type datetime}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
