table Reservas
	lineageTag: a7dc8ffd-3a27-5e5a-a125-8e075907eabb

	measure 'Total reservas' = COUNTROWS(Reservas) + 0
		formatString: #,0
		lineageTag: 139322b0-edd8-5ad9-9084-c5e04bc30d91

	measure 'Reservas confirmadas' = CALCULATE(COUNTROWS(Reservas), Reservas[status] = "confirmed") + 0
		formatString: #,0
		lineageTag: ece95725-8401-54b2-a825-b162f529de6a

	measure 'Reservas canceladas' = CALCULATE(COUNTROWS(Reservas), Reservas[status] = "cancelled") + 0
		formatString: #,0
		lineageTag: 29d9a864-c0b9-5147-a380-ca479d884555

	measure '% canceladas' = DIVIDE([Reservas canceladas], [Total reservas])
		formatString: 0.0%
		lineageTag: cfa008bd-41a8-5050-a5ac-ebfd5f1df9d6

	measure '% recurrentes' = DIVIDE(CALCULATE(COUNTROWS(Reservas), NOT ISBLANK(Reservas[series_id])), [Total reservas])
		formatString: 0.0%
		lineageTag: f52eda37-e3c5-55ae-932d-62df689466df

	measure 'Anticipación promedio (días)' = CALCULATE(AVERAGE(Reservas[Días de anticipación]), Reservas[status] = "confirmed")
		formatString: #,0.0
		lineageTag: 93048bcd-06a3-5de2-ad57-25606f3e5e01

	measure 'Asistentes promedio' = CALCULATE(AVERAGE(Reservas[attendees]), Reservas[status] = "confirmed")
		formatString: #,0.0
		lineageTag: a0fdc17e-be63-5ce8-abcc-e2de489f005b

	measure 'Reservas próximos 7 días' = CALCULATE(COUNTROWS(Reservas), Reservas[status] = "confirmed", Reservas[local_date] >= TODAY(), Reservas[local_date] < TODAY() + 7, REMOVEFILTERS(Calendario)) + 0
		formatString: #,0
		lineageTag: 89a4b886-3a26-5ef3-9408-4bae67dcbaa0

