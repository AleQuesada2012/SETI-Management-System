		annotation SummarizationSetBy = Automatic

	column asset_name
		dataType: string
		summarizeBy: none
		sourceColumn: asset_name
		lineageTag: 8e5dc287-1514-5e36-aeba-b60812b1cb6c

		annotation SummarizationSetBy = Automatic

	column kind
		dataType: string
		summarizeBy: none
		sourceColumn: kind
		lineageTag: 5a61039d-b932-550d-accd-1054a151cace

