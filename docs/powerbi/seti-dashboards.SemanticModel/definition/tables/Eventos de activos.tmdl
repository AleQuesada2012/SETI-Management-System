table 'Eventos de activos'
	lineageTag: 5fd64c52-54c0-5ad5-a43c-b79786c0f6b9

	measure 'Total eventos' = COUNTROWS('Eventos de activos') + 0
		formatString: #,0
		lineageTag: 511588ff-db30-5116-bdf7-fb25cc6d789c

	column id
		dataType: int64
		formatString: 0
		summarizeBy: none
