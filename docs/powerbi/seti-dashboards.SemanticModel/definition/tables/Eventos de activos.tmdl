		annotation SummarizationSetBy = Automatic

	column Tipo = SWITCH([kind], "damage", "Daño", "loss", "Pérdida", "recovery", "Recuperación", "decommission", "Baja", [kind])
		dataType: string
		summarizeBy: none
		lineageTag: b4c6e36e-324b-5e34-9e60-9c349994c186

		annotation SummarizationSetBy = Automatic

	partition 'Eventos de activos' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(FeedUrl, [RelativePath = "asset_events.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"id", Int64.Type}, {"asset_id", Int64.Type}, {"asset_code", type text}, {"asset_name", type text}, {"kind", type text}, {"occurred_on", type date}, {"registered_by_name", type text}, {"evidence_count", Int64.Type}, {"created_at", type datetime}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
