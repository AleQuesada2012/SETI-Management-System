model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-CR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["FeedUrl", "Activos", "Espacios", "Reservas", "Ocupación", "Mantenimientos", "Eventos de activos", "Movimientos", "Usuarios", "Roles de usuario", "Reportes generados", "Actualización"]

annotation PBI_ProTooling = ["DevMode"]

ref table Activos
ref table Espacios
ref table Reservas
ref table 'Ocupación'
ref table Mantenimientos
ref table 'Eventos de activos'
ref table Movimientos
ref table Usuarios
ref table 'Roles de usuario'
ref table 'Reportes generados'
ref table Calendario
ref table 'Actualización'
